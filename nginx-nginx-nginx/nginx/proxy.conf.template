# Переменные, которые будут подставлены Docker-ом:
# $NEXT_UPSTREAM — куда слать дальше (следующий nginx или app)
# $PUBLIC_ENTRYPOINT — флаг, указывающий, что узел может принимать внешний трафик от LB

# Настраиваем модуль real_ip. 
# Мы доверяем ТОЛЬКО нашему тупому балансировщику (172.28.0.10). 
# Если запрос пришел от LB, модуль real_ip запишет настоящий IP пользователя в $remote_addr.
set_real_ip_from  172.28.0.10;
real_ip_header    X-Real-IP;

# КАРТА БЕЗОПАСНОСТИ ЗАГОЛОВКОВ:
# Мы проверяем, откуда физически пришел пакет ($realip_remote_addr).
# 1. Если пакет пришел от балансировщика (172.28.0.10) — это ВХОД в нашу систему.
#    Мы ПОЛНОСТЬЮ стираем присланный пользователем XFF и пишем туда только его честный IP ($remote_addr).
# 2. Если пакет пришел от соседа-Nginx (из подсети 172.28.0.0/24) — это движение по цепочке.
#    Мы берем существующий X-Forwarded-For и красиво добавляем к нему IP предыдущего прокси.
map $realip_remote_addr $validated_xff {
    "172.28.0.10"   $remote_addr;
    default         "$http_x_forwarded_for, $realip_remote_addr";
}

server {
    listen 80;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Передаем наружу нашу валидированную цепочку без фейков
        proxy_set_header X-Forwarded-For $validated_xff;

        # Переменная подставится из docker-compose окружения автоматически
        # Проксируем на следующий узел
        proxy_pass http://${NEXT_UPSTREAM};
    }
}