# Доверяем всей внутренней сети Docker
set_real_ip_from  172.28.0.0/24;
real_ip_header    X-Real-IP;

# ШАГ 1: Валидация самого содержимого X-Forwarded-For.
# Если заголовок пустой или начинается строго с нашей внутренней подсети 172.28.0.0, 
# мы сохраняем его. Если там мусор (9.9.9.9), мы его полностью обнуляем.

map $http_x_forwarded_for $cleaned_http_xff {
    ""                  "";
    ~^172\.28\.0\.      $http_x_forwarded_for;
    default             "";
}

# ШАГ 2: Проверка физического отправителя пакета.
map $realip_remote_addr $validated_xff {
    # Если пакет пришел от балансировщика, мы игнорируем входящий XFF и пишем только его IP.
    "172.28.0.10"   $remote_addr;

    # Если пакет пришел от соседа-Nginx (или при прямом curl), мы берем 
    # ОЧИЩЕННЫЙ на Шаге 1 заголовок и добавляем IP отправителя.
    default         "${cleaned_http_xff}, $realip_remote_addr";
}

# Убираем ведущую запятую и любые пробелы после неё (даже если их 0 или несколько)
map $validated_xff $final_xff {
    ~^,*(.+)        $1; 
    default         $validated_xff;
}

server {
    listen 80;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Передаем наружу нашу валидированную цепочку без фейков
        proxy_set_header X-Forwarded-For $final_xff;

        proxy_set_header X-Real-IP $remote_addr;
       
        # Переменная подставится из docker-compose окружения автоматически
        # Проксируем на следующий узел
        proxy_pass http://${NEXT_UPSTREAM};
    }
}